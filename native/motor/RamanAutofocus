#!/bin/bash
# Launcher for the motor program on macOS and Linux (native/PORT_SPEC.md section 1/3). On Windows the
# controller starts raman_autofocus.py with the interpreter itself.
# The Qt controller starts it as  handshake_v2/motor/RamanAutofocus <sessionDir> <sessionId> [1d-x|1d-y]
# with this folder as working directory; the real program is exec'ed with the same cwd and
# arguments.  build.py replaces @PYTHON@ with the absolute interpreter path
# (no PATH assumptions when started from a GUI app); until then python3 is used.
PYTHON="@PYTHON@"
case "$PYTHON" in @*) PYTHON=python3 ;; esac
# Safety stop: the process to watch. The controller passes its own pid; otherwise it is our parent.
export RAMAN_CONTROLLER_PID="${RAMAN_CONTROLLER_PID:-$PPID}"
exec "$PYTHON" "$(dirname "$0")/raman_autofocus.py" "$@"
